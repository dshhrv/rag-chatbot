root  ::= object
object  ::= "{" ws pair (ws "," ws pair)* ws "}"
pair    ::= string ws ":" ws value
value   ::= string | array | number | object | boolean | null
array   ::= "[" ws (value (ws "," ws value)*)? ws "]"
string  ::= "\"" (char | escape)* "\""
char    ::= [^"\\\x7F\x00-\x1F]
escape  ::= "\\" ["\\/bfnrt] | "\\u" [0-9a-fA-F]{4}
number  ::= "-"? ([0-9] | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [-+]? [0-9]+)?
boolean ::= "true" | "false"
null    ::= "null"
ws      ::= [ \t\n]*